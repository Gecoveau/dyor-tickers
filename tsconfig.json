{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "outDir": "com.skizd.deckedstream.sdPlugin/bin",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
