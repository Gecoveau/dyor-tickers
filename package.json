{
  "name": "dyor-tickers",
  "version": "0.1.1",
  "description": "Stream Deck tiles for live stock and crypto prices. No API keys required.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.skizd.deckedstream\"",
    "pack": "streamdeck pack com.skizd.deckedstream.sdPlugin"
  },
  "author": "Gecoveau",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gecoveau/dyor-tickers.git"
  },
  "homepage": "https://github.com/Gecoveau/dyor-tickers#readme",
  "bugs": {
    "url": "https://github.com/Gecoveau/dyor-tickers/issues"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.8.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.0.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
